#!/usr/bin/env bashio
# ==============================================================================
# s6-overlay finish script for WhatsApp Add-on
# ==============================================================================
declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.warning "WhatsApp add-on process exited with code ${APP_EXIT_CODE}; s6 will restart if configured."
fi
